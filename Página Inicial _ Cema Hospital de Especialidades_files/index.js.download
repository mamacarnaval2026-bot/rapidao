$('#exampleModalCenter').modal('show');

// noticias blog

$(document).ready(function(){
    $('.slider-dicas').slick({
        dots: false,
        infinite: true,
        speed: 600,
        slidesToShow: 3,
        slidesToScroll: 1,
        autoplay: true,
        autoplaySpeed: 4000,
        arrows: true,
        adaptiveHeight: false,
        prevArrow: '<button type="button" class="slick-prev" style="left:-40px; z-index:100;"></button>',
        nextArrow: '<button type="button" class="slick-next" style="right:-40px; z-index:100;"></button>',
        responsive: [
            {
                breakpoint: 1100,
                settings: {
                    slidesToShow: 2
                }
            },
            {
                breakpoint: 768,
                settings: {
                    slidesToShow: 1,
                    arrows: false, /* No mobile geralmente usamos dots ou arraste */
                    dots: true
                }
            }
        ]
    });
});
